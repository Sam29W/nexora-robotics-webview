# ==============================================================================
# NEXORA Robotics - Environment Configuration Template
# ==============================================================================
# DO NOT commit real secrets or production keys to source control.
# Copy this file to .env and populate with your credentials.

# --- Backend Configuration ---
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# --- Supabase Configuration ---
# Obtain from https://supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Frontend Website Configuration ---
VITE_API_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Mobile App WebView Configuration ---
# The URL loaded by the Android WebView
EXPO_PUBLIC_WEBSITE_URL=https://sam29w.github.io/nexora-robotics-webview/
